<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#17171B">

    <TextView
        android:id="@+id/lyrics_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PULSE LYRICS"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lyrics_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nothing playing"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/lyrics_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#999999"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/lyrics_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Play a song to see lyrics"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:maxLines="8"
        android:ellipsize="end" />

</LinearLayout>
