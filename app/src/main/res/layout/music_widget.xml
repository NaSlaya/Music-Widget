<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <!-- Main music card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Artwork -->

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginEnd="14dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_artwork_card"
            android:contentDescription="Album artwork" />

        <!-- Information -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●  NOW PLAYING"
                android:textColor="#B7BDFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Nothing playing"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Unknown artist"
                android:textColor="#AEB2C5"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Decorative spectrum -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="3dp"
            android:layout_height="7dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="11dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="17dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="23dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="15dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="19dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="25dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="22dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="17dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="27dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

        <TextView
            android:layout_width="3dp"
            android:layout_height="15dp"
            android:layout_margin="2dp"
            android:background="@drawable/widget_bar"
            android:text="" />

    </LinearLayout>

    <!-- Playback controls -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_previous"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#DDE0F5"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/widget_control_button"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_play"
            android:layout_width="62dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/widget_play_button"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#DDE0F5"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/widget_control_button"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
