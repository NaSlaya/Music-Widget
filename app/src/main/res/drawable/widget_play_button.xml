<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#8B91FF"
                android:centerColor="#656DFF"
                android:endColor="#4B51C4" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#C3C7FF" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#777FFF"
                android:centerColor="#6269ED"
                android:endColor="#454BB7" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#AEB3FF" />

        </shape>

    </item>

</selector>
