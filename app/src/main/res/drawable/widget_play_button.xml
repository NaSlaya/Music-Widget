<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#565DCC"
                android:endColor="#737BFF" />

            <corners android:radius="25dp" />

            <stroke
                android:width="1dp"
                android:color="#A5AAFF" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#737BFF"
                android:endColor="#4E55C7" />

            <corners android:radius="25dp" />

            <stroke
                android:width="1dp"
                android:color="#9BA0FF" />

        </shape>

    </item>

</selector>
