<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#454B70"
                android:endColor="#292E4D" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#7E84B4" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#303550"
                android:endColor="#1C2038" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#4B5277" />

        </shape>

    </item>

</selector>
